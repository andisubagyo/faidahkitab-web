---
import { getCollection, render } from 'astro:content';
import Dasar from '../layouts/Dasar.astro';
import { SITE, slugKategori, formatTanggal, sudahTerbit, waktuBaca } from '../site';

export async function getStaticPaths() {
  const semua = await getCollection('artikel', ({ data }) => sudahTerbit(data));
  return semua.map((a) => ({ params: { slug: a.id }, props: { a } }));
}

const { a } = Astro.props;
const { Content } = await render(a);
const d = a.data;
const url = new URL(`/${a.id}/`, Astro.site).href;
const gambar = `/thumbnail/${a.id}.png`;

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.judul,
    description: d.deskripsi,
    datePublished: d.tanggal.toISOString(),
    dateModified: (d.diperbarui ?? d.tanggal).toISOString(),
    inLanguage: 'id',
    author: { '@type': 'Organization', name: d.penulis },
    publisher: { '@type': 'Organization', name: SITE.nama },
    mainEntityOfPage: url,
    image: new URL(gambar, Astro.site).href,
  },
];
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.tanya,
      acceptedAnswer: { '@type': 'Answer', text: f.jawab },
    })),
  });
}
---
<Dasar title={d.judulSeo} description={d.deskripsi} jenis="article" jsonLd={jsonLd} gambar={gambar}>
  <section class="artikel-kepala" slot="hero">
    <div class="wadah-baca">
      <a class="kategori" href={`/kategori/${slugKategori(d.kategori)}/`}>{d.kategori}</a>
      <h1>{d.judul}</h1>
      <div class="info">
        <span>{formatTanggal(d.tanggal)}</span>
        <span>{waktuBaca(a.body ?? '')} menit baca</span>
        <span>Sumber: <em>{d.kitab}</em></span>
      </div>
    </div>
  </section>

  <article class="lembar">
    <Content />

    {
      d.faq.length > 0 && (
        <section class="tanya" aria-labelledby="judul-tanya">
          <h2 id="judul-tanya">Tanya jawab</h2>
          {d.faq.map((f) => (
            <details>
              <summary>{f.tanya}</summary>
              <p>{f.jawab}</p>
            </details>
          ))}
        </section>
      )
    }

    <div class="pemeriksa">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.9-4.9 1.4 1.4-6.3 6.3z"/></svg>
      <div>
        Ditulis oleh <strong>{d.penulis}</strong>
        {d.pemeriksa && <><br />Diperiksa oleh <strong>{d.pemeriksa}</strong></>}
      </div>
    </div>
  </article>

  <div class="ajak">
    <p>Dapatkan faedah singkat setiap hari dari kitab para ulama.</p>
    <a class="tombol tombol-emas" href={SITE.telegram}>Gabung channel Telegram</a>
  </div>
</Dasar>
