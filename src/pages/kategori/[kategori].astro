---
import { getCollection } from 'astro:content';
import Dasar from '../../layouts/Dasar.astro';
import { SITE, slugKategori, formatTanggal, sudahTerbit } from '../../site';

export function getStaticPaths() {
  return SITE.kategori.map((k) => ({ params: { kategori: slugKategori(k) }, props: { nama: k } }));
}

const { nama } = Astro.props;
const artikel = (
  await getCollection('artikel', ({ data }) => sudahTerbit(data) && data.kategori === nama)
).sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf());
---
<Dasar title={`Artikel ${nama}`} description={`Kumpulan artikel ${nama} dari kitab para ulama.`}>
  <h1>{nama}</h1>
  {artikel.length === 0 && <p class="meta">Artikel untuk kategori ini segera hadir, in syaa Allah.</p>}
  {
    artikel.map((a) => (
      <div class="kartu">
        <h2><a href={`/${a.id}/`}>{a.data.judul}</a></h2>
        <p>{a.data.deskripsi}</p>
        <p class="meta" style="margin:0">{formatTanggal(a.data.tanggal)}</p>
      </div>
    ))
  }
</Dasar>
